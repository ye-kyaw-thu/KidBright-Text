# Node dependencies (installed locally, never committed)
node_modules/
**/node_modules/

# Runtime user data and generated output at repository root
/data/
/temp/
/tmp/
/kbt-demo-output/
/dist/
/release/
/coverage/

# ESP32 generated build output only; keep esp32/lib/release tracked
/esp32/build/

# Python caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Device-specific QR/MAC image from a local hardware setup
/app/public/images/qrcode.png

# Credentials and local secrets
.env
.env.*
!.env.example
api.txt
api_key*
api-key*
credentials*
*.pem
*.p12
*.pfx
*.key

# Logs and operating-system/editor files
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local backups
kbt-*-backup-*/
kbt-*-backup-*
*.bak
*.bak-*
*.node24-backup

# Large downloaded compiler toolchains and platform flash tools
/xtensa-esp32-elf/
/esp32ulp-elf-binutils/
/esptool.exe
/esptool
