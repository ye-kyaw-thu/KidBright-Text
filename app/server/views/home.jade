extends layout

- var supportedBlocklyLanguages = ['en', 'th', 'my', 'km', 'lo', 'vi'];
- var activeBlocklyLanguage = supportedBlocklyLanguages.indexOf(ulang) >= 0 ? ulang : 'en';

block content
	nav.navbar-default(style="padding-left:0px;").header
		.container-fluid(style="margin:0vh 1vw 0vh 1vw;")
			ul.nav.navbar-nav
				img(src="/images/SVG/Logo.svg", height="60").kb_logo_top
				li.kbt-mode-buttons
					button#kbt-mode-visual.kbt-mode-button.active(type='button') Visual Programming
				li.kbt-mode-buttons
					button#kbt-mode-text.kbt-mode-button(type='button') KidBright Text
			ul.nav.navbar-nav.navbar-right
				li#kbt-language-picker(style="padding: 8px 10px 0 0")
					select#language-select.form-control(aria-label="Blockly language", data-selected-language=activeBlocklyLanguage, style="min-width: 145px")
						option(value="en", selected=activeBlocklyLanguage == 'en') English
						option(value="th", selected=activeBlocklyLanguage == 'th') ไทย
						option(value="my", selected=activeBlocklyLanguage == 'my') မြန်မာ
						option(value="km", selected=activeBlocklyLanguage == 'km') ខ្មែរ
						option(value="lo", selected=activeBlocklyLanguage == 'lo') ລາວ
						option(value="vi", selected=activeBlocklyLanguage == 'vi') Tiếng Việt
				//- li
				//- 	.lang-container
				//- 		.lang-text
				//- 			a#home-lang-en(href="#",title="Switch to english language").link-url Eng
				//- 		.lang-space.link-url
				//- 			| |
				//- 		.lang-text
				//- 			a#home-lang-th(href="#",title="สลับไปใช้ภาษาไทย").link-url ไทย
				li(style="padding-left: 10px")
					.lang-container
						.lang-text(style="color: #fff")#version-text
							| version

			ul.nav.navbar-nav.navbar-right(style="padding-right:1%")

				li
					button#btn-new.navbar-btn.btn-icon(style="background-image: url(/images/SVG/new-file.svg)")
				li
					button#btn-open.navbar-btn.btn-icon(style="background-image: url(/images/SVG/h3.svg)")
				li
					a#btn-save.navbar-btn.btn-icon(style="background-image: url(/images/SVG/save-file.svg); margin-right:25px;" href="javascript:void(0)" download="data.txt")
				//- li
					//- button#btn-delete.navbar-btn.btn-icon(style="background-image: url(/images/SVG/h2.svg); margin-right:25px;") Delete File
				li
					button#btn-build.navbar-btn.btn-icon(disabled="true" style="background-image: url(/images/SVG/h1.svg)") Program Build
				li
					button#btn-setclock.setclock-btn.navbar-btn.btn-icon(disabled="true" style="background-image: url(/images/SVG/h6.svg)") Set Clock
				li
					button#btn-wifi-config.navbar-btn.btn-icon(style="background-image: url(/images/SVG/h5.svg); margin-left:15px;") WIFI Configss
				li
					button#btn-qrcode.btn.navbar-btn.btn-icon(style="background-image: url(/images/SVG/h7.svg)") QRsss Codes

				//- li
				//- 	#accordionExample.accordion
				//- 		div
				//- 			button.navbar-btn.btn-icon(data-target='#collapseOne', data-toggle='collapse', type='button', aria-controls='collapseOne', aria-expanded='true', style="background-image: url(/images/SVG/export.svg)")
				//- 			#collapseOne.collapse(data-parent='#accordionExample', aria-labelledby='headingOne')
				//- 				div(style="background-color:#0000;")
				//- 					button.btn-success(style='display:flex; border-radius: 5px; margin-top: 5px; ')
				//- 						| export
				//- 					button.btn-success(style='display: flex; border-radius: 5px; margin-top: 5px;')
				//- 						| import



