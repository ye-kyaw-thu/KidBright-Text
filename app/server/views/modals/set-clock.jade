.modal-set-clock.modal.fade
	.modal-dialog(style="width:25%; height:200;")
		.modal-content
			.modal-header.modal-h
				img(src="/images/SVG/modalicon/m5.svg", style="height:40px; display:inline;")
				h4(style="display:inline; vertical-align:middle;")
			.modal-body.modal-b(style="text-align: center")
				div#div-sub7(style="display: none;")
					P#time-sub7
				div(style="vertical-align: middle;")
					P#time-zero
			.modal-footer.modal-f
				center
					div#div-sub7(style="display: none;")
						button#button-sub7.btn.btn-primary -7
					div(style="vertical-align: middle; display:inline;")
						button#button-zero.btn.btn-primary Set Clock
					
					button#btn-cancel(data-dismiss="modal").cancel.btn.btn-danger(style="display:inline;") Cancel

